<launch>
  <!-- Final localization-only entry point. Start `morai-connect 1` first,
       or set start_connections=true for a standalone local run. -->
  <arg name="start_connections" default="false" />
  <arg name="simulator_ip" default="127.0.0.1" />
  <arg name="bind_ip" default="127.0.0.1" />
  <arg name="status_port" default="1909" />
  <arg name="collision_port" default="7789" />
  <arg name="control_port" default="7777" />
  <arg name="gps_port" default="9090" />
  <arg name="imu_port" default="9091" />
  <arg name="lidar_port" default="2368" />
  <arg name="vehicle_state_topic" default="/Competition_topic" />
  <arg name="publish_tf" default="true" />

  <include if="$(arg start_connections)"
           file="$(find morai_launch)/launch/competition_udp_connections.launch">
    <arg name="simulator_ip" value="$(arg simulator_ip)" />
    <arg name="bind_ip" value="$(arg bind_ip)" />
    <arg name="status_port" value="$(arg status_port)" />
    <arg name="collision_port" value="$(arg collision_port)" />
    <arg name="control_port" value="$(arg control_port)" />
    <arg name="gps_port" value="$(arg gps_port)" />
    <arg name="imu_port" value="$(arg imu_port)" />
    <arg name="lidar_port" value="$(arg lidar_port)" />
    <arg name="enable_control_output" value="false" />
    <arg name="show_camera_windows" value="false" />
  </include>

  <include file="$(find morai_launch)/launch/gps_odometry_eskf.launch">
    <arg name="vehicle_state_topic" value="$(arg vehicle_state_topic)" />
    <arg name="publish_tf" value="$(arg publish_tf)" />
    <arg name="publish_sensor_tf" value="true" />
  </include>
</launch>
