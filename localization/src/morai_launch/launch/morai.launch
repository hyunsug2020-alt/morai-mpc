<launch>
  <!-- Legacy localization entry point retained as a UDP-only wrapper.
       It uses the same competition gateway and never opens ROS WebSocket. -->
  <arg name="simulator_ip" default="$(optenv MORAI_SIM_IP 127.0.0.1)" />
  <arg name="bind_ip" default="$(optenv MORAI_LOCAL_IP 127.0.0.1)" />
  <arg name="status_port" default="$(optenv MORAI_STATUS_PORT 1909)" />
  <arg name="collision_port" default="$(optenv MORAI_COLLISION_PORT 7789)" />
  <arg name="control_port" default="$(optenv MORAI_CONTROL_PORT 9093)" />
  <arg name="physical_max_steer_deg" default="40.0" />
  <arg name="lidar_port" default="2368" />
  <arg name="imu_port" default="9091" />
  <arg name="gps_port" default="9090" />
  <arg name="start_imu_input" default="true" />
  <arg name="use_udp_imu" default="true" />
  <arg name="use_official_velodyne" default="true" />
  <arg name="start_gps_udp" default="true" />
  <arg name="start_gps_odometry" default="true" />
  <arg name="start_lidar" default="true" />
  <arg name="start_localization" default="true" />
  <arg name="start_lio_sam" default="true" />
  <arg name="start_lio_navsat" default="false" />
  <arg name="start_lio_rviz" default="false" />
  <arg name="start_around_view" default="false" />
  <arg name="show_around_view_window" default="true" />
  <arg name="around_view_packet_format" default="auto" />
  <arg name="start_odometry_validation" default="false" />
  <arg name="odometry_validation_output"
       default="/tmp/morai_odometry_accuracy.json" />
  <arg name="publish_localization_tf" default="false" />
  <arg name="publish_sensor_tf" default="false" />
  <arg name="sensor_config_file"
       default="$(find morai_control)/config/morai_sensor.json" />
  <arg name="vehicle_config"
       default="$(find morai_control)/config/ioniq5_vehicle.yaml" />
  <arg name="eskf_config"
       default="$(find eskf)/config/eskf_robust.yaml" />
  <arg name="start_pure_odometry" default="true" />
  <arg name="raw_lidar_topic" default="/velodyne_points" />
  <arg name="lio_lidar_topic" default="/velodyne_points_lio" />
  <arg name="pure_odometry_topic" default="/odometry/pure" />
  <arg name="lio_odometry_topic" default="/lio_sam/mapping/odometry" />
  <arg name="lio_degeneracy_topic"
       default="/lio_sam/mapping/odometry_incremental" />
  <arg name="eskf_output_topic" default="/eskf/odom" />

  <include file="$(find morai_launch)/launch/competition_udp_connections.launch">
    <arg name="simulator_ip" value="$(arg simulator_ip)" />
    <arg name="bind_ip" value="$(arg bind_ip)" />
    <arg name="status_port" value="$(arg status_port)" />
    <arg name="collision_port" value="$(arg collision_port)" />
    <arg name="control_port" value="$(arg control_port)" />
    <arg name="physical_max_steer_deg" value="$(arg physical_max_steer_deg)" />
    <arg name="enable_control_output" value="false" />
    <arg name="lidar_port" value="$(arg lidar_port)" />
    <arg name="imu_port" value="$(arg imu_port)" />
    <arg name="gps_port" value="$(arg gps_port)" />
    <arg name="start_imu_input" value="$(arg start_imu_input)" />
    <arg name="start_gps_udp" value="$(arg start_gps_udp)" />
    <arg name="start_lidar_udp" value="$(arg start_lidar)" />
    <arg name="use_official_velodyne"
         value="$(arg use_official_velodyne)" />
    <arg name="resample_imu_for_lio" value="$(arg start_lio_sam)" />
    <arg name="start_input_monitor" value="$(arg start_lio_sam)" />
    <arg name="normalize_lidar_time" value="$(arg start_lio_sam)" />
    <arg name="start_gps_odometry" value="$(arg start_gps_odometry)" />
    <arg name="start_lio_sam" value="$(arg start_lio_sam)" />
    <arg name="start_robot_state_publisher" value="$(arg start_lio_sam)" />
    <arg name="show_camera_windows" value="false" />
  </include>

  <!-- Optional three-camera around view (front, left and right).
       Disabled by default so MORAI camera UDP ports are only opened on demand. -->
  <include if="$(arg start_around_view)"
           file="$(find around_view)/launch/around_view.launch">
    <arg name="packet_format" value="$(arg around_view_packet_format)" />
    <arg name="start_camera_receiver" value="false" />
    <arg name="source_ip" value="$(arg simulator_ip)" />
    <arg name="bind_ip" value="$(arg bind_ip)" />
    <arg name="show_camera_windows" value="false" />
    <arg name="show_avm_window" value="$(arg show_around_view_window)" />
  </include>

  <!-- Canonical vehicle position: /eskf/odom and /localization/ego_status. -->
  <include if="$(arg start_localization)"
           file="$(find morai_control)/launch/sensor_fusion.launch">
    <arg name="publish_tf" value="$(arg publish_localization_tf)" />
    <arg name="publish_sensor_tf" value="$(arg publish_sensor_tf)" />
    <arg name="sensor_config_file" value="$(arg sensor_config_file)" />
    <arg name="vehicle_config" value="$(arg vehicle_config)" />
    <arg name="eskf_config" value="$(arg eskf_config)" />
    <arg name="start_pure_odometry" value="$(arg start_pure_odometry)" />
    <arg name="vehicle_state_topic" value="/Competition_topic" />
    <arg name="pure_odometry_topic" value="$(arg pure_odometry_topic)" />
    <arg name="slam_topic" value="$(arg lio_odometry_topic)" />
    <arg name="slam_degeneracy_topic"
         value="$(arg lio_degeneracy_topic)" />
    <arg name="eskf_output_topic" value="$(arg eskf_output_topic)" />
  </include>

  <include if="$(arg start_odometry_validation)"
           file="$(find morai_control)/launch/odometry_validation.launch">
    <arg name="vehicle_config" value="$(arg vehicle_config)" />
    <arg name="eskf_topic" value="$(arg eskf_output_topic)" />
    <arg name="lio_sam_topic" value="$(arg lio_odometry_topic)" />
    <arg name="output_file" value="$(arg odometry_validation_output)" />
  </include>

</launch>
