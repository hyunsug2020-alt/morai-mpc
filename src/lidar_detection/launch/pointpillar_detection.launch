<launch>
  <arg name="point_cloud_topic" default="/velodyne_points"/>
  <arg name="marker_topic" default="/lidar_detection/detection_markers"/>
  <arg name="detections_topic" default="/lidar_detection/detections"/>
  <arg name="score_threshold" default="0.445"/>
  <arg name="max_range" default="70.4"/>
  <arg name="output_frame" default=""/>
  <arg name="publish_labels" default="true"/>
  <arg name="remove_ground" default="true"/>
  <arg name="filtered_points_topic" default="/lidar_detection/points_no_ground"/>
  <arg name="ground_distance_threshold" default="0.15"/>
  <arg name="ground_ransac_iterations" default="48"/>
  <arg name="ground_max_tilt_deg" default="12.0"/>
  <arg name="ground_min_range" default="2.0"/>
  <arg name="ground_max_range" default="50.0"/>
  <arg name="ground_candidate_max_z" default="-0.5"/>
  <arg name="ground_min_plane_height" default="-2.5"/>
  <arg name="ground_max_plane_height" default="-0.7"/>
  <arg name="ground_ransac_sample_size" default="2048"/>
  <arg name="ground_min_inliers" default="300"/>
  <arg name="start_rviz" default="true"/>
  <arg name="python_executable"
       default="$(find lidar_detection)/../../.venv-openpcdet/bin/python"/>
  <arg name="model_dir"
       default="$(find lidar_detection)/../../trained_models/morai_pointpillar_2026-07-31"/>
  <arg name="checkpoint" default="$(arg model_dir)/best_model.pth"/>
  <arg name="model_config" default="$(arg model_dir)/pointpillar_morai.yaml"/>
  <arg name="data_config" default="$(arg model_dir)/morai_dataset.yaml"/>
  <arg name="rviz_config"
       default="$(find lidar_detection)/config/pointpillar_detection.rviz"/>

  <node pkg="lidar_detection"
        type="pointpillar_detector.py"
        name="pointpillar_detector"
        output="screen"
        required="true"
        launch-prefix="$(arg python_executable)">
    <env name="CUDA_VISIBLE_DEVICES" value="0"/>
    <env name="CUDA_MODULE_LOADING" value="LAZY"/>
    <env name="OMP_NUM_THREADS" value="4"/>
    <env name="MKL_NUM_THREADS" value="4"/>
    <env name="OPENBLAS_NUM_THREADS" value="4"/>
    <env name="PYTORCH_CUDA_ALLOC_CONF" value="max_split_size_mb:128"/>
    <param name="point_cloud_topic" value="$(arg point_cloud_topic)"/>
    <param name="marker_topic" value="$(arg marker_topic)"/>
    <param name="detections_topic" value="$(arg detections_topic)"/>
    <param name="score_threshold" value="$(arg score_threshold)"/>
    <param name="max_range" value="$(arg max_range)"/>
    <param name="output_frame" value="$(arg output_frame)"/>
    <param name="publish_labels" value="$(arg publish_labels)"/>
    <param name="remove_ground" value="$(arg remove_ground)"/>
    <param name="filtered_points_topic" value="$(arg filtered_points_topic)"/>
    <param name="ground_distance_threshold" value="$(arg ground_distance_threshold)"/>
    <param name="ground_ransac_iterations" value="$(arg ground_ransac_iterations)"/>
    <param name="ground_max_tilt_deg" value="$(arg ground_max_tilt_deg)"/>
    <param name="ground_min_range" value="$(arg ground_min_range)"/>
    <param name="ground_max_range" value="$(arg ground_max_range)"/>
    <param name="ground_candidate_max_z" value="$(arg ground_candidate_max_z)"/>
    <param name="ground_min_plane_height" value="$(arg ground_min_plane_height)"/>
    <param name="ground_max_plane_height" value="$(arg ground_max_plane_height)"/>
    <param name="ground_ransac_sample_size" value="$(arg ground_ransac_sample_size)"/>
    <param name="ground_min_inliers" value="$(arg ground_min_inliers)"/>
    <param name="checkpoint" value="$(arg checkpoint)"/>
    <param name="model_config" value="$(arg model_config)"/>
    <param name="data_config" value="$(arg data_config)"/>
  </node>

  <node if="$(arg start_rviz)"
        pkg="rviz"
        type="rviz"
        name="pointpillar_rviz"
        args="-d $(arg rviz_config)"
        output="screen"/>
</launch>
