<?xml version="1.0"?>
<package format="2">
  <name>camera_vehicle_training</name>
  <version>0.1.0</version>
  <description>MORAI camera vehicle dataset collection and automatic YOLO labelling.</description>

  <maintainer email="bisa@example.com">bisa</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>cv_bridge</depend>
  <depend>morai_msgs</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>

  <exec_depend>around_view</exec_depend>
  <exec_depend>image_view</exec_depend>
  <exec_depend>morai_launch</exec_depend>
  <exec_depend>rosbridge_server</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export/>
</package>
