Panels:
  - Class: rviz/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Cones1
        - /ParkingBox1
        - /Goal1
        - /Path1
        - /ObstacleGrid1
      Splitter Ratio: 0.5
    Tree Height: 700

Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.4
      Cell Size: 1
      Class: rviz/Grid
      Color: 100; 100; 110
      Enabled: true
      Line Style: { Line Width: 0.03, Value: Lines }
      Name: Grid
      Plane: XY
      Plane Cell Count: 100
      Reference Frame: <Fixed Frame>
      Value: true

    - Class: rviz/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 1.5
      Name: TF
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Update Interval: 0
      Value: true

    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /cone_detector/cone_markers
      Name: Cones
      Queue Size: 100
      Value: true

    - Class: rviz/Marker
      Enabled: true
      Marker Topic: /parking_planner/box
      Name: ParkingBox
      Queue Size: 100
      Value: true

    - Alpha: 1
      Axes Length: 2.5
      Axes Radius: 0.15
      Class: rviz/Pose
      Color: 50; 255; 50
      Enabled: true
      Head Length: 0.5
      Head Radius: 0.3
      Name: Goal
      Shaft Length: 1.5
      Shaft Radius: 0.1
      Shape: Arrow
      Topic: /parking_planner/goal
      Value: true

    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 255; 200; 0
      Enabled: true
      Head Diameter: 0.3
      Head Length: 0.2
      Length: 0.3
      Line Style: Lines
      Line Width: 0.08
      Name: Path
      Offset: { X: 0, Y: 0, Z: 0.1 }
      Pose Color: 255; 100; 0
      Pose Style: Arrows
      Radius: 0.03
      Shaft Diameter: 0.1
      Shaft Length: 0.3
      Topic: /parking_planner/path
      Value: true

    - Alpha: 0.5
      Class: rviz/Map
      Color Scheme: costmap
      Draw Behind: true
      Enabled: true
      Name: ObstacleGrid
      Topic: /parking_planner/obstacle_grid
      Use Timestamp: false
      Value: true

  Enabled: true
  Global Options:
    Background Color: 25; 25; 30
    Default Light: true
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 40
      Focal Point: { X: 0, Y: 0, Z: 0 }
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 1.0
      Target Frame: ego_vehicle
      Yaw: 4.71
    Saved: ~

Window Geometry:
  Displays: { collapsed: false }
  Height: 900
  Width: 1700
  X: 100
  Y: 100
