Panels:
  - Class: rviz/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /TF1
        - /PointCloud21
        - /Cones1
      Splitter Ratio: 0.5
    Tree Height: 600

Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.4
      Cell Size: 1
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 100
      Reference Frame: <Fixed Frame>
      Value: true

    - Class: rviz/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 2.0
      Name: TF
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Update Interval: 0
      Value: true

    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 2
        Min Value: -0.5
        Value: false
      Axis: Z
      Channel Name: intensity
      Class: rviz/PointCloud2
      Color: 50; 200; 255
      Color Transformer: AxisColor
      Decay Time: 0
      Enabled: false
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Name: ProcessedCloud
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.05
      Style: Points
      Topic: /cone_detector/processed_cloud
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: true
      Value: false

    - Alpha: 0.3
      Autocompute Intensity Bounds: true
      Axis: Z
      Channel Name: intensity
      Class: rviz/PointCloud2
      Color: 150; 150; 150
      Color Transformer: AxisColor
      Decay Time: 0
      Enabled: false
      Name: CombinedCloud_raw
      Size (Pixels): 1
      Style: Points
      Topic: /cone_detector/combined_cloud
      Use Fixed Frame: true
      Value: false

    - Alpha: 0.5
      Class: rviz/PointCloud2
      Color: 100; 200; 255
      Color Transformer: FlatColor
      Enabled: false
      Name: LiDAR1_raw
      Size (Pixels): 1
      Style: Points
      Topic: /lidar3D_1
      Use Fixed Frame: false
      Value: false

    - Alpha: 0.5
      Class: rviz/PointCloud2
      Color: 255; 200; 100
      Color Transformer: FlatColor
      Enabled: false
      Name: LiDAR2_raw
      Size (Pixels): 1
      Style: Points
      Topic: /lidar3D_2
      Use Fixed Frame: false
      Value: false

    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /cone_detector/cone_markers
      Name: Cones
      Namespaces:
        cones: true
      Queue Size: 100
      Value: true

    - Class: rviz/PoseArray
      Enabled: true
      Topic: /cone_detector/cones
      Color: 255; 100; 0
      Arrow Length: 0.4
      Name: ConePoses
      Value: true

  Enabled: true
  Global Options:
    Background Color: 30; 30; 35
    Default Light: true
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 25
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.9
      Target Frame: ego_vehicle
      Yaw: 0
    Saved: ~

Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: 000000ff
  Width: 1600
  X: 100
  Y: 100
