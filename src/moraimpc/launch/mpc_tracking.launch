<launch>
    <!-- TF_REPEATED_DATA 경고 억제 (MORAI 중복 TF 발행) -->
    <env name="ROSCONSOLE_CONFIG_FILE"
         value="$(find moraimpc)/config/rosconsole.config" />

    <!-- WSLg: OpenCV(GTK3) 대시보드 창을 Wayland 대신 X11 백엔드로 강제 (안 하면 창 안뜸) -->
    <env name="GDK_BACKEND" value="x11" />

    <!-- 사용자 인자 (혼합 D/R 경로 녹화 파일 바로 지정 가능) -->
    <arg name="recorded_file"        default="$(find moraimpc)/data/waypoints_recorded.json" />
    <arg name="path_file"            default="$(find moraimpc)/data/mixed.json" />
    <arg name="target_vel"           default="40.0" />  <!-- km/h, 직선 순항. 곡선 자동 감속(60→40: 급커브 사전감속 여유) -->
    <arg name="ltv_only"             default="false" />
    <arg name="live_tuning"          default="true" />
    <arg name="param_reload_period_s" default="0.5" />
    <arg name="reverse_max_vel"      default="2.0" />
    <arg name="pre_gear_change_dist" default="10.0" />  <!-- 5→10: 더 일찍 사전감속 (60km/h시 42m) -->
    <arg name="log_file"             default="$(find moraimpc)/logs/mpc_log.json" />
    <arg name="avoidance_enabled"    default="false" />  <!-- LTV corridor 장애물 회피 (/Object_topic) -->
    <arg name="curve_decel_enable"   default="true" />
    <arg name="curve_speed_alpha"    default="12.0" />
    <arg name="curve_alat_max"       default="2.8" />
    <arg name="curve_lookahead_min_m" default="25.0" />
    <arg name="curve_lookahead_max_m" default="70.0" />
    <arg name="curve_lookahead_time_s" default="2.5" />
    <arg name="curve_brake_decel_mps2" default="2.0" />
    <arg name="curve_min_vel_kmh"    default="6.0" />
    <arg name="kappa_gain"           default="1.28" />
    <arg name="max_steer_rate"       default="50.0" />
    <arg name="max_steer_deg"        default="35.0" />
    <arg name="w_dr"                 default="220.0" />
    <arg name="w_theta_low_speed"    default="250.0" />
    <arg name="w_theta_high_speed"   default="220.0" />
    <arg name="w_kappa"              default="120.0" />
    <arg name="w_u"                  default="5200.0" />
    <arg name="w_u_v_gain"           default="350.0" />
    <arg name="w_dr_curve_boost"     default="2.8" />

    <!-- 0. MORAI 자율주행 모드 활성화 (ctrl_mode=3 + D 진입) — 시작 시 1회 publish -->
    <node pkg="moraimpc" type="morai_mode_init.py" name="morai_mode_init" output="screen" />

    <!-- 1. LTV-MPC + RTI-NMPC 경로 추종기 (전진 D / 후진 R 자동 전환)
         launch-prefix: 시작 전 smooth_waypoints 자동 적용 (recorded_file 존재 시) -->
    <node pkg="moraimpc" type="path_follower_node" name="path_follower_node" output="screen"
          launch-prefix="$(find moraimpc)/scripts/run_with_smoothing.sh $(arg recorded_file) $(arg path_file)">
        <remap from="/ctrl_cmd_0" to="/ctrl_cmd" />   <!-- MORAI는 /ctrl_cmd 구독 -->
        <param name="path_file"             value="$(arg path_file)" />
        <param name="target_vel"            value="$(arg target_vel)" />
        <param name="ltv_only"              value="$(arg ltv_only)" />
        <param name="live_tuning"           value="$(arg live_tuning)" />
        <param name="param_reload_period_s" value="$(arg param_reload_period_s)" />
        <param name="reverse_max_vel"       value="$(arg reverse_max_vel)" />
        <param name="pre_gear_change_dist_m" value="$(arg pre_gear_change_dist)" />
        <param name="log_file"              value="$(arg log_file)" />
        <param name="force_nmpc"            value="false" />  <!-- LTV 기본(steer35°·덜튐). NMPC는 후진/주차/저속/회피만 -->
        <param name="avoidance_enabled"     value="$(arg avoidance_enabled)" />  <!-- LTV corridor 회피 -->
        <param name="curve_decel_enable"    value="$(arg curve_decel_enable)" />
        <param name="curve_speed_alpha"     value="$(arg curve_speed_alpha)" />
        <param name="curve_alat_max"        value="$(arg curve_alat_max)" />
        <param name="curve_lookahead_min_m" value="$(arg curve_lookahead_min_m)" />
        <param name="curve_lookahead_max_m" value="$(arg curve_lookahead_max_m)" />
        <param name="curve_lookahead_time_s" value="$(arg curve_lookahead_time_s)" />
        <param name="curve_brake_decel_mps2" value="$(arg curve_brake_decel_mps2)" />
        <param name="curve_min_vel_kmh"     value="$(arg curve_min_vel_kmh)" />
        <param name="kappa_gain"            value="$(arg kappa_gain)" />
        <param name="max_steer_rate"        value="$(arg max_steer_rate)" />
        <param name="max_steer_deg"         value="$(arg max_steer_deg)" />
        <param name="w_dr"                  value="$(arg w_dr)" />
        <param name="w_theta_low_speed"     value="$(arg w_theta_low_speed)" />
        <param name="w_theta_high_speed"    value="$(arg w_theta_high_speed)" />
        <param name="w_kappa"               value="$(arg w_kappa)" />
        <param name="w_u"                   value="$(arg w_u)" />
        <param name="w_u_v_gain"            value="$(arg w_u_v_gain)" />
        <param name="w_dr_curve_boost"      value="$(arg w_dr_curve_boost)" />

    </node>

    <!-- 2. C++ 실시간 대시보드 (OpenCV) — 차량 중심 close-up 뷰 -->
    <node pkg="moraimpc" type="mpc_dashboard_node" name="mpc_dashboard_cpp" output="screen">
        <param name="path_file"          value="$(arg path_file)" />
        <param name="window_m"           value="12.0" />        <!-- 차량 중심 ±12m close-up -->
        <param name="follow_vehicle"     value="true" />        <!-- 차량 따라가는 zoom -->
        <param name="hdg_pct_thresh_deg" value="10.0" />
    </node>
</launch>
