<launch>
    <!-- 경로 추종 + NMPC stage 제약 기반 장애물 회피 통합 launch -->
    <!-- TF_REPEATED_DATA 경고 억제 (MORAI 중복 TF 발행) -->
    <env name="ROSCONSOLE_CONFIG_FILE"
         value="$(find moraimpc)/config/rosconsole.config" />

    <!-- 사용자 인자 -->
    <arg name="recorded_file"        default="$(find moraimpc)/data/waypoints_recorded.json" />
    <arg name="path_file"            default="$(find moraimpc)/data/mixed_avoid.json" />
    <arg name="smoothed_path"        default="$(find moraimpc)/data/mixed.json" />
    <arg name="target_vel"           default="30.0" />
    <arg name="reverse_max_vel"      default="2.0" />
    <arg name="pre_gear_change_dist" default="10.0" />
    <arg name="log_file"             default="$(find moraimpc)/logs/mpc_log.json" />

    <!-- NMPC stage 제약 (방안 B) 회피 인자 -->
    <arg name="nmpc_obs_enable"       default="false" />  <!-- path만 추종 (path_replanner가 회피 path 생성, follower는 path만) -->
    <arg name="nmpc_obs_safe_margin"  default="1.0" />
    <arg name="nmpc_obs_active_dist"  default="8.0" />   <!-- 12→8 복원 (조기 트리거 오버슛 방지) -->
    <arg name="nmpc_obs_max_count"    default="5" />     <!-- 동시 처리 최대 개수 -->
    <arg name="nmpc_obs_skip_first"   default="1" />     <!-- k=1..skip stage 제약 skip -->
    <arg name="nmpc_w_obs_slack_quad" default="1e5" />
    <arg name="nmpc_w_obs_slack_lin"  default="1e3" />

    <!-- 0. MORAI 자율주행 모드 활성화 -->
    <node pkg="moraimpc" type="morai_mode_init.py" name="morai_mode_init" output="screen" />

    <!-- 1. path_follower (추종 + NMPC stage 제약 회피) -->
    <node pkg="moraimpc" type="path_follower_node" name="path_follower_node" output="screen"
          launch-prefix="$(find moraimpc)/scripts/run_replanner_then_follower.sh $(arg recorded_file) $(arg smoothed_path) $(arg path_file)">
        <param name="path_file"             value="$(arg path_file)" />
        <param name="target_vel"            value="$(arg target_vel)" />
        <param name="reverse_max_vel"       value="$(arg reverse_max_vel)" />
        <param name="pre_gear_change_dist_m" value="$(arg pre_gear_change_dist)" />
        <param name="log_file"              value="$(arg log_file)" />
        <param name="force_nmpc"            value="true" />   <!-- NMPC만 사용 -->
        <param name="avoidance_enabled"     value="false" />  <!-- LTV corridor 미사용 -->
        <!-- NMPC stage 제약 회피 -->
        <param name="nmpc_obs_enable"       value="$(arg nmpc_obs_enable)" />
        <param name="nmpc_obs_safe_margin"  value="$(arg nmpc_obs_safe_margin)" />
        <param name="nmpc_obs_active_dist"  value="$(arg nmpc_obs_active_dist)" />
        <param name="nmpc_obs_max_count"    value="$(arg nmpc_obs_max_count)" />
        <param name="nmpc_obs_skip_first"   value="$(arg nmpc_obs_skip_first)" />
        <param name="nmpc_w_obs_slack_quad" value="$(arg nmpc_w_obs_slack_quad)" />
        <param name="nmpc_w_obs_slack_lin"  value="$(arg nmpc_w_obs_slack_lin)" />
    </node>

    <!-- 2. simple_dashboard는 cycle 외부 영구 실행 (infinite_cycle.sh가 nohup으로 띄움 — mtime watch로 mixed_avoid.json 변경 자동 reload) -->
</launch>
