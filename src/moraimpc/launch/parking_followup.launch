<launch>
    <!-- Parking Follow-up: Hybrid A* 경로 생성 + path_follower 추종 (NMPC 저속모드)
         절차:
           1. parking_planner 실행 → RViz 2D Goal Pose 클릭 → mixed_park.json 저장
           2. 사용자가 별도 path_follower launch 또는 본 launch 재실행
              (parking_planner 동안 path_follower 미실행 → mixed_park.json 생성 후
               이 launch에 가서 follow=true로 path_follower 시작)
    -->
    <env name="ROSCONSOLE_CONFIG_FILE" value="$(find moraimpc)/config/rosconsole.config" />

    <arg name="rviz"             default="true" />
    <arg name="run_cone_detector" default="true" />
    <arg name="follow"           default="false" />   <!-- true면 mixed_park.json 추종 -->
    <arg name="output_path_file" default="$(find moraimpc)/data/mixed_park.json" />
    <arg name="reverse_max_vel"  default="2.0" />
    <arg name="target_vel"       default="6.0" />     <!-- 저속 주차 -->

    <!-- 콘 검출기 -->
    <group if="$(arg run_cone_detector)">
        <include file="$(find moraimpc)/launch/cone_detector.launch">
            <arg name="rviz" value="false" />
            <arg name="accumulate" value="true" />
        </include>
    </group>

    <!-- Parking Planner (Hybrid A* + JSON 저장) -->
    <node pkg="moraimpc" type="parking_planner_node" name="parking_planner" output="screen">
        <param name="map_frame"      value="map" />
        <param name="min_cones"      value="3" />
        <param name="inflation_r"    value="1.25" />
        <param name="grid_res"       value="0.25" />
        <param name="grid_size"      value="60.0" />
        <param name="box_pad"        value="0.30" />
        <param name="plan_period"    value="1.0" />

        <param name="plan_step"        value="0.7" />
        <param name="plan_xy_res"      value="0.5" />
        <param name="plan_max_iter"    value="20000" />
        <param name="plan_safety"      value="0.30" />
        <param name="plan_reverse_pen" value="1.5" />
        <param name="plan_switch_pen"  value="2.0" />

        <!-- 경로 mixed.json 저장 — path_follower 호환 -->
        <param name="output_path_file" value="$(arg output_path_file)" />
        <param name="densify_step"     value="0.20" />
    </node>

    <!-- Path Follower — follow=true일 때만 시작 -->
    <node if="$(arg follow)" pkg="moraimpc" type="path_follower_node" name="path_follower_node"
          output="screen">
        <param name="path_file"             value="$(arg output_path_file)" />
        <param name="target_vel"            value="$(arg target_vel)" />
        <param name="reverse_max_vel"       value="$(arg reverse_max_vel)" />
        <param name="pre_gear_change_dist_m" value="3.0" />
    </node>

    <!-- RViz -->
    <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz_parking"
          args="-d $(find moraimpc)/rviz/parking_planner.rviz" required="false" output="screen"
          launch-prefix="$(find moraimpc)/scripts/run_filtered.sh" />
</launch>
