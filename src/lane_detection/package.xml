<?xml version="1.0"?>
<package format="2">
  <name>lane_detection</name>
  <version>0.1.0</version>
  <description>SegFormer lane segmentation for an existing MORAI front-camera topic.</description>

  <maintainer email="bisa@example.com">bisa</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>rospy</depend>
