<?xml version="1.0"?>
<package format="2">
  <name>eskf</name>
  <version>0.1.0</version>
  <description>Reusable robust planar ESKF core for MORAI localization</description>
  <maintainer email="coss@todo.todo">coss</maintainer>
  <license>TODO</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>geometry_msgs</depend>
  <depend>morai_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf</depend>
  <depend>tf2_ros</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>python3-pyqt5</exec_depend>
  <test_depend>python3-nose</test_depend>

  <export />
</package>
