<launch>
  <!-- One-command front-camera YOLO + LiDAR PointPillars + 2D/3D fusion. -->
  <arg name="start_camera_receiver" default="true"/>
  <arg name="start_lidar_receiver" default="true"/>
  <arg name="show_viewer" default="true"/>
  <arg name="lidar_port" default="2368"/>
  <arg name="camera_config"
       default="$(find camera_vehicle_training)/config/front_camera_udp.yaml"/>
  <arg name="calibration_config"
       default="$(find around_view)/config/lidar_camera_calibration.yaml"/>
  <arg name="calibration_file"
       default="$(env HOME)/.ros/around_view/lidar_camera_calibration.yaml"/>

  <include if="$(arg start_camera_receiver)"
           file="$(find around_view)/launch/camera_view.launch">
    <arg name="camera_config" value="$(arg camera_config)"/>
    <arg name="show_windows" value="false"/>
    <arg name="packet_format" value="current19"/>
  </include>

  <include if="$(arg start_lidar_receiver)"
           file="$(find velodyne_pointcloud)/launch/VLP16_points.launch">
    <arg name="port" value="$(arg lidar_port)"/>
    <arg name="frame_id" value="velodyne"/>
    <arg name="rpm" value="600.0"/>
    <arg name="min_range" value="1.0"/>
    <arg name="max_range" value="100.0"/>
    <arg name="organize_cloud" value="false"/>
  </include>

  <include file="$(find camera_vehicle_training)/launch/camera_vehicle_detection.launch">
    <arg name="start_camera_receiver" value="false"/>
    <arg name="show_viewer" value="false"/>
  </include>

  <include file="$(find lidar_detection)/launch/pointpillar_detection.launch">
    <arg name="point_cloud_topic" value="/velodyne_points"/>
    <arg name="start_rviz" value="false"/>
  </include>

  <node pkg="around_view"
        type="camera_lidar_vehicle_fusion_node.py"
        name="camera_lidar_vehicle_fusion"
        output="screen"
        required="true">
    <rosparam command="load" file="$(arg calibration_config)"/>
    <param name="calibration_file" value="$(arg calibration_file)"/>
    <param name="image_topic" value="/around_view/camera/front/image_raw"/>
    <param name="camera_detections_topic"
           value="/camera_vehicle_detection/detections"/>
    <param name="lidar_detections_topic"
           value="/lidar_detection/detections"/>
    <param name="overlay_topic" value="/camera_lidar_fusion/overlay"/>
    <param name="fused_detections_topic"
           value="/camera_lidar_fusion/detections"/>
    <param name="maximum_time_difference" value="0.40"/>
    <param name="minimum_iou" value="0.05"/>
    <param name="maximum_center_ratio" value="0.75"/>
    <param name="camera_only_enabled" value="true"/>
    <rosparam param="nominal_vehicle_size">[4.8, 2.0, 1.5]</rosparam>
    <param name="depth_center_offset_ratio" value="0.55"/>
    <param name="recent_lidar_hold_s" value="0.60"/>
    <param name="maximum_camera_only_range" value="70.0"/>
  </node>

  <node if="$(arg show_viewer)"
        pkg="image_view"
        type="image_view"
        name="camera_lidar_fusion_viewer"
        output="screen">
    <remap from="image" to="/camera_lidar_fusion/overlay"/>
    <param name="autosize" value="true"/>
  </node>
</launch>
