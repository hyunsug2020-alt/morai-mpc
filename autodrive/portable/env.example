# Edit paths to the Python environments and existing models on the destination PC.
# BUNDLE_ROOT is set by common.sh; no source-PC username is required.
STUDENT_PYTHON="$BUNDLE_ROOT/.venv-student/bin/python"
STUDENT_VEHICLE_PYTHON="$BUNDLE_ROOT/.venv-openpcdet/bin/python"
STUDENT_CHECKPOINT="$BUNDLE_ROOT/autodrive/student_v3_claude/best_v5.pt"
STUDENT_V6_CHECKPOINT="$BUNDLE_ROOT/autodrive/student_v3_claude/v6_model.pt"
STUDENT_VEHICLE_MODEL_DIR="$BUNDLE_ROOT/trained_models/morai_pointpillar_20k_2026-08-14"
SEMANTIC_MODEL_DIR="$BUNDLE_ROOT/semantic/models/semantic_b1_noyellow_v2_final_20261002"
MORAI_SAVEFILE_DIR="$HOME/MoraiLauncher_Lin/MoraiLauncher_Lin_Data/SaveFile"
